[22.929, "o", "\u001b[2J\u001b[HConfirm five saved workflows\r\n\r\n$ python3 -c 'import json; from pathlib import Path; records=[json.loads(line) for line in Path(\"tmp/os_skill_installations.jsonl\").read_text().splitlines()]; names={row[\"name\"] for row in records if row[\"installed\"] and Path(row[\"reconciled_path\"]).is_file()}; expected={\"evidence-research\",\"decision-experiment\",\"verified-execution\",\"research-to-implementation\",\"teach-and-repeat\"}; assert expected <= names; print(\"Five workflows have verified saved installation records:\"); print(\"\\n\".join(sorted(expected)))'\r\n"]
